# Database connection. Python builds DATABASE_URL from these values.
PGHOST=127.0.0.1
PGPORT=54329
PGUSER=requestdesk
PGPASSWORD=requestdesk
PGDATABASE=requestdesk
PGDATA=.pgdata
PG_BIN=C:\Program Files\PostgreSQL\15\bin

# Set DATABASE_URL only when the host, port, or password above should be ignored,
# for example inside Docker.
# DATABASE_URL=postgresql+psycopg://requestdesk:requestdesk@db:5432/requestdesk

ADMIN_USERNAME=admin
ADMIN_PASSWORD=RequestDesk!2026
SESSION_SECRET=request-desk-local-demo-secret
